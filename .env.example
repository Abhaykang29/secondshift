# SecondShift config - copy to .env
PROVIDER=mock
SEGMENTER=
VISION=
CACHE_MODE=off
BUDGET_USD=140
META_API_KEY=
DATA_DIR=data
MAX_CAPTURE_MINUTES=6
SAMPLE_FPS=2
SHARPNESS_MIN=100
BRIGHTNESS_MIN=30
BRIGHTNESS_MAX=230
SCENE_CHANGE_MIN=0.25
MAX_GAP_S=3
MAX_KEYFRAMES=80
PROPOSE_BATCH=12
PROPOSE_MODEL=spark
VERIFY_FRAMES=3
MIN_MASK_SCORE=0.5
VERIFY_MODE=sam_plus_judge
IMAGE_TOKENS_ESTIMATE=1500
ROUTINE_SEND_UNBLURRED=0
WATCH_FPS=1
MAX_CALLS_PER_HOUR=60
CONFIRM_EVERY_S=60
ALLOW_CONTRIBUTOR_FOR_SYNTHETIC_TEXT=0

# Privacy copy mode: free (hackathon credits - content may be used for
# product improvement) or paid (Standard tier terms). Default: free.
CREDITS_MODE=free
